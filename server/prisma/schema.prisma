generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model bookmark_tags {
  bookmark_id Int
  tag_id      Int
  bookmarks   bookmarks @relation(fields: [bookmark_id], references: [bookmark_id], onDelete: Cascade, onUpdate: NoAction, map: "bookmark_tags_ibfk_1")
  tags        tags      @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade, onUpdate: NoAction, map: "bookmark_tags_ibfk_2")

  @@id([bookmark_id, tag_id])
  @@index([tag_id], map: "tag_id")
}

model bookmarks {
  bookmark_id   Int             @id @default(autoincrement())
  user_id       Int
  url           String          @db.VarChar(2048)
  title         String          @db.VarChar(255)
  note          String?         @db.Text
  is_visited    Boolean?        @default(false)
  is_starred    Boolean?        @default(false)
  is_private    Boolean?        @default(false)
  saved_on      DateTime?       @default(now()) @db.Timestamp(0)
  bookmark_tags bookmark_tags[]
  users         users           @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "bookmarks_ibfk_1")

  @@index([user_id], map: "user_id")
}

model tags {
  tag_id        Int             @id @default(autoincrement())
  tag           String?         @unique(map: "tag") @db.VarChar(255)
  bookmark_tags bookmark_tags[]
}

model users {
  user_id         Int         @id @default(autoincrement())
  username        String      @unique(map: "username") @db.VarChar(50)
  email           String      @unique(map: "email") @db.VarChar(255)
  hashed_password String      @db.VarChar(255)
  created_at      DateTime?   @default(now()) @db.Timestamp(0)
  bookmarks       bookmarks[]
}
